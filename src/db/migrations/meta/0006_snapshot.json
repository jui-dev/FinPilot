          "name": "ck_transactions_occurred_on",
          "value": "date(\"transactions\".\"occurred_on\") IS NOT NULL AND \"transactions\".\"occurred_on\" = date(\"transactions\".\"occurred_on\")"
        },
        "ck_transactions_sequence": {
          "name": "ck_transactions_sequence",
          "value": "\"transactions\".\"sequence\" >= 1"
        },
        "ck_transactions_income": {
          "name": "ck_transactions_income",
          "value": "\"transactions\".\"type\" <> 'income' OR (\"transactions\".\"amount_minor\" > 0 AND \"transactions\".\"category_id\" IS NOT NULL AND \"transactions\".\"counter_account_id\" IS NULL AND \"transactions\".\"refund_of_id\" IS NULL)"
        },
        "ck_transactions_expense": {
          "name": "ck_transactions_expense",
          "value": "\"transactions\".\"type\" <> 'expense' OR (\"transactions\".\"amount_minor\" < 0 AND \"transactions\".\"category_id\" IS NOT NULL AND \"transactions\".\"counter_account_id\" IS NULL AND \"transactions\".\"refund_of_id\" IS NULL)"
        },
        "ck_transactions_refund": {
          "name": "ck_transactions_refund",
          "value": "\"transactions\".\"type\" <> 'refund' OR (\"transactions\".\"amount_minor\" > 0 AND \"transactions\".\"category_id\" IS NOT NULL AND \"transactions\".\"counter_account_id\" IS NULL)"
        },
        "ck_transactions_transfer": {
          "name": "ck_transactions_transfer",
          "value": "\"transactions\".\"type\" <> 'transfer' OR (\"transactions\".\"amount_minor\" < 0 AND \"transactions\".\"counter_account_id\" IS NOT NULL AND \"transactions\".\"counter_account_id\" <> \"transactions\".\"account_id\" AND \"transactions\".\"category_id\" IS NULL AND \"transactions\".\"refund_of_id\" IS NULL)"
        },
        "ck_transactions_opening_adjustment": {
          "name": "ck_transactions_opening_adjustment",
          "value": "\"transactions\".\"type\" NOT IN ('opening_balance', 'adjustment') OR (\"transactions\".\"amount_minor\" <> 0 AND \"transactions\".\"category_id\" IS NULL AND \"transactions\".\"counter_account_id\" IS NULL AND \"transactions\".\"refund_of_id\" IS NULL)"
        }
      }
